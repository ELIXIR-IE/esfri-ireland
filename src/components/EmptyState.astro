---
interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

<div class="empty-state">
  <span class="empty-state-icon" aria-hidden="true" set:html={icon} />
  <p class="section-intro" style="margin-left:0;">Content for this page is coming soon.</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-7) 0;
  }

  .empty-state-icon {
    display: inline-flex;
    width: 64px;
    height: 64px;
    color: var(--color-border);
    margin-bottom: var(--space-4);
  }

  .empty-state-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
