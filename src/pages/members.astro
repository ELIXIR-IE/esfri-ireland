---
import yaml from "js-yaml";
import rawYaml from "../data/esfris.yaml?raw";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Entry {
  id: string;
  name: string;
  full_name: string | null;
  description: string;
  domain: string;
  eosc_cluster: string;
  ireland_status: string;
  tier: "engaged" | "to_be_onboarded" | "not_member";
  category: "esfri" | "eiro";
  roadmap_status: "Project" | "Landmark" | null;
  site_structure: "Distributed" | "Single-sited" | null;
  website: string | null;
  logo: string | null;
  email: string | null;
  national_node?: {
    name: string;
    website: string | null;
  } | null;
}

const entries = yaml.load(rawYaml) as Entry[];

const base = import.meta.env.BASE_URL;

function initials(name: string) {
  return name.replace(/[^A-Za-z0-9]/g, "").slice(0, 2).toUpperCase();
}

const areas = [...new Set(entries.map((e) => e.domain))].sort();

const tiers: { key: Entry["tier"]; label: string; intro: string }[] = [
  {
    key: "engaged",
    label: "Engaged",
    intro: "Founding and active members of the IENN forum.",
  },
  {
    key: "to_be_onboarded",
    label: "To Be Onboarded",
    intro: "Ireland is a member/observer of this ESFRI or EIRO, but it isn't part of the IENN grassroots forum yet.",
  },
  {
    key: "not_member",
    label: "Not a Member",
    intro: "Ireland is not currently a member of this ESFRI or EIRO.",
  },
];
---

<BaseLayout title="Members" description="ESFRI Research Infrastructures and EIROs, and Ireland's engagement with each, via the IENN grassroots forum.">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">Members</p>
      <h1>ESFRI &amp; EIRO Registry</h1>
      <p class="section-intro" style="margin-left:0;">
        Every ESFRI Research Infrastructure and EIRO, classified by Ireland's
        current engagement with the IENN grassroots forum. Filter by type,
        thematic area, or search by name below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <details class="card legend-card">
        <summary class="legend-heading">Information about this registry</summary>
        <div class="legend-content">
          <div class="grid grid-2 legend-grid">
            <div>
              <h3 class="legend-subheading">Engagement tiers</h3>
              <ul class="legend-list">
                <li><span class="badge badge-tier-engaged">Engaged</span> — founding/active IENN members.</li>
                <li><span class="badge badge-tier-to-be-onboarded">To Be Onboarded</span> — Ireland has ESFRI/EIRO membership or links, but isn't in IENN yet.</li>
                <li><span class="badge badge-tier-not-member">Not a Member</span> — Ireland has no current membership.</li>
              </ul>
            </div>
            <div>
              <h3 class="legend-subheading">ESFRI vs EIRO</h3>
              <p class="legend-text">
                <strong>ESFRI</strong> Research Infrastructures are on the European
                Strategy Forum on Research Infrastructures roadmap. <strong>EIROs</strong>
                (European Intergovernmental Research Organisations, e.g. CERN, EMBL, ESA)
                are related but separate treaty-based organisations, included here for
                their European significance.
              </p>
            </div>
            <div>
              <h3 class="legend-subheading">Project vs Landmark</h3>
              <p class="legend-text">
                From the <a href="https://roadmap2021.esfri.eu/projects-and-landmarks/view-the-table/" target="_blank" rel="noopener">ESFRI Roadmap 2021</a>:
                <strong>Landmark</strong> infrastructures are fully implemented and
                operating; <strong>Project</strong> infrastructures are still being
                developed. <em>This classification is from 2021 and may be outdated
                for some entries — shown as indicative, not authoritative.</em>
              </p>
            </div>
            <div>
              <h3 class="legend-subheading">Distributed vs Single-sited</h3>
              <p class="legend-text">
                <strong>Distributed</strong> infrastructures operate across multiple
                national nodes/outstations — this is the structure that matters most
                for Ireland, since it's how an Irish outstation becomes possible at all.
                <strong>Single-sited</strong> infrastructures have one physical location
                elsewhere in Europe.
              </p>
            </div>
          </div>
        </div>
      </details>

      <div class="registry-filters card">
        <div class="filter-field">
          <label for="category-filter">Type</label>
          <select id="category-filter">
            <option value="">ESFRI &amp; EIRO</option>
            <option value="esfri">ESFRI only</option>
            <option value="eiro">EIRO only</option>
          </select>
        </div>
        <div class="filter-field">
          <label for="domain-filter">Thematic area</label>
          <select id="domain-filter">
            <option value="">All areas</option>
            {areas.map((d) => <option value={d}>{d}</option>)}
          </select>
        </div>
        <div class="filter-field">
          <label for="search-filter">Search by name</label>
          <input id="search-filter" type="text" placeholder="e.g. ELIXIR, DARIAH..." />
        </div>
        <button id="filter-clear" type="button" class="btn btn-outline filter-clear">Clear filters</button>
      </div>
      <p id="result-count" class="result-count"></p>

      {tiers.map((tier) => (
        <div class={`tier-section tier-section-${tier.key}`} data-tier-section={tier.key}>
          <h2 class="tier-heading">
            {tier.label}
            <span class={`badge badge-tier-${tier.key.replace(/_/g, "-")}`}>{tier.label}</span>
          </h2>
          <p class="tier-intro">{tier.intro}</p>

          <div class="grid grid-3 members-grid">
            {entries
              .filter((e) => e.tier === tier.key)
              .map((entry) => (
                <div
                  class:list={["card", "org-card", entry.category === "eiro" && "org-card-eiro"]}
                  data-domain={entry.domain}
                  data-category={entry.category}
                  data-search={`${entry.name} ${entry.full_name ?? ""}`.toLowerCase()}
                >
                  {entry.website && (
                    <a
                      class="org-card-link"
                      href={entry.website}
                      target="_blank"
                      rel="noopener"
                      aria-label={`Visit ${entry.name} website`}
                    ></a>
                  )}
                  <span class={`org-category-tag org-category-tag-${entry.category}`}>
                    {entry.category === "eiro" ? "EIRO" : "ESFRI"}
                  </span>
                  <div class="org-card-head">
                    {entry.logo ? (
                      <img class="org-logo" src={`${base}${entry.logo}`} alt="" loading="lazy" />
                    ) : (
                      <div class="org-logo org-logo-fallback" aria-hidden="true">{initials(entry.name)}</div>
                    )}
                    <span
                      class:list={["mail-dot", entry.email && "mail-dot-active"]}
                      title={entry.email ? `Contact: ${entry.email}` : "No contact email listed yet"}
                      aria-label={entry.email ? `Contact email available for ${entry.name}` : `No contact email listed yet for ${entry.name}`}
                    ></span>
                  </div>
                  <h3 class="org-name">{entry.name}</h3>
                  {entry.full_name && <p class="org-fullname">{entry.full_name}</p>}
                  <p class="org-desc">{entry.description}</p>
                  
                  {entry.national_node && (
                    <div class="org-national-node">
                      <span class="eyebrow" style="font-size: 0.65rem; margin-bottom: 0;">National Node</span>
                      {entry.national_node.website ? (
                        <a 
                          href={entry.national_node.website} 
                          target="_blank" 
                          rel="noopener"
                          class="national-node-link"
                        >
                          {entry.national_node.name}
                          <svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </a>
                      ) : (
                        <span class="national-node-link">{entry.national_node.name}</span>
                      )}
                    </div>
                  )}

                  <div class="org-meta">
                    <span class="badge badge-domain">{entry.domain}</span>
                    {entry.roadmap_status && <span class="badge badge-outline">{entry.roadmap_status}</span>}
                    {entry.site_structure && <span class="badge badge-outline">{entry.site_structure}</span>}
                  </div>
                </div>
              ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    const categoryFilter = document.querySelector<HTMLSelectElement>("#category-filter");
    const domainFilter = document.querySelector<HTMLSelectElement>("#domain-filter");
    const searchFilter = document.querySelector<HTMLInputElement>("#search-filter");
    const clearBtn = document.querySelector<HTMLButtonElement>("#filter-clear");
    const resultCount = document.querySelector<HTMLParagraphElement>("#result-count");
    const cards = Array.from(document.querySelectorAll<HTMLDivElement>(".org-card"));
    const tierSections = Array.from(document.querySelectorAll<HTMLDivElement>("[data-tier-section]"));

    function applyFilters() {
      const category = categoryFilter?.value ?? "";
      const domain = domainFilter?.value ?? "";
      const search = (searchFilter?.value ?? "").trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = !category || card.dataset.category === category;
        const matchesDomain = !domain || card.dataset.domain === domain;
        const matchesSearch = !search || (card.dataset.search ?? "").includes(search);
        const show = matchesCategory && matchesDomain && matchesSearch;
        card.style.display = show ? "" : "none";
        if (show) visible++;
      });

      tierSections.forEach((section) => {
        const anyVisible = Array.from(section.querySelectorAll<HTMLDivElement>(".org-card")).some(
          (c) => c.style.display !== "none"
        );
        section.style.display = anyVisible ? "" : "none";
      });

      if (resultCount) {
        resultCount.textContent = `${visible} of ${cards.length} shown`;
      }
    }

    categoryFilter?.addEventListener("change", applyFilters);
    domainFilter?.addEventListener("change", applyFilters);
    searchFilter?.addEventListener("input", applyFilters);
    clearBtn?.addEventListener("click", () => {
      if (categoryFilter) categoryFilter.value = "";
      if (domainFilter) domainFilter.value = "";
      if (searchFilter) searchFilter.value = "";
      applyFilters();
    });

    applyFilters();
  </script>

  <style>
    .legend-card {
      margin-bottom: var(--space-5);
      background: var(--color-bg-subtle);
    }

    .legend-heading {
      margin-bottom: 0;
      font-size: var(--fs-h2);
      font-weight: 700;
      color: var(--color-heading);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .legend-heading::before {
      content: "▶";
      font-size: 1rem;
      color: var(--color-accent);
      transition: transform 0.2s ease;
    }

    details[open] .legend-heading::before {
      transform: rotate(90deg);
    }

    .legend-content {
      margin-top: var(--space-5);
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }

    .legend-grid {
      gap: var(--space-5);
    }

    .legend-subheading {
      font-size: var(--fs-h4);
      margin-bottom: var(--space-2);
    }

    .legend-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--fs-small);
    }

    .legend-text {
      font-size: var(--fs-small);
      margin-bottom: 0;
    }

    .registry-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: flex-end;
      margin-bottom: var(--space-2);
      background: var(--color-bg-subtle);
    }

    .filter-field {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      flex: 1 1 220px;
    }

    .filter-field label {
      font-size: var(--fs-small);
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .filter-field input,
    .filter-field select {
      padding: 0.6rem 0.8rem;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 1rem;
    }

    .filter-field input:focus,
    .filter-field select:focus {
      border-color: var(--color-accent);
      outline: none;
    }

    .filter-clear {
      white-space: nowrap;
    }

    .result-count {
      color: var(--color-text-muted);
      font-size: var(--fs-small);
      margin-bottom: var(--space-5);
    }

    .tier-section {
      margin-top: var(--space-7);
      padding: var(--space-6);
      border-radius: var(--radius-lg);
    }

    .tier-section:first-of-type {
      margin-top: var(--space-4);
    }

    .tier-section-engaged {
      background: var(--color-badge-engaged-bg);
    }

    .tier-section-to_be_onboarded {
      background: var(--color-badge-onboard-bg);
    }

    .tier-section-not_member {
      background: var(--color-badge-notmember-bg);
    }

    .tier-heading {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .tier-intro {
      color: var(--color-text-muted);
      margin-bottom: var(--space-5);
      max-width: 760px;
    }

    .members-grid {
      margin-top: var(--space-4);
    }

    .org-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-top: calc(var(--space-5) + var(--space-3));
    }

    .org-card-eiro {
      background: var(--color-eiro-card-bg);
    }

    .org-category-tag {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      z-index: 2;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2em 0.6em;
      border-radius: 999px;
      color: #fff;
    }

    .org-category-tag-esfri {
      background: var(--color-esfri-tag-bg);
    }

    .org-category-tag-eiro {
      background: var(--color-eiro-tag-bg);
    }

    .org-card-link {
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--radius-md);
    }

    .org-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    .org-logo {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      object-fit: contain;
      background: var(--color-bg-subtle);
    }

    .org-logo-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-green-800);
      color: #fff;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
    }

    .mail-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--color-border);
      flex-shrink: 0;
      margin-top: 4px;
    }

    .mail-dot-active {
      background: var(--color-green-600);
    }

    .org-name {
      margin-bottom: 0;
      font-size: 1.1rem;
    }

    .org-fullname {
      color: var(--color-text-muted);
      font-size: var(--fs-small);
      margin-bottom: 0;
    }

    .org-desc {
      font-size: var(--fs-small);
      margin-bottom: 0;
      flex-grow: 1;
    }

    .org-national-node {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px dashed var(--color-border);
    }

    .national-node-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 600;
      color: var(--color-link);
      font-size: 1rem;
      transition: color 0.2s ease;
    }
    
    a.national-node-link:hover {
      color: var(--color-accent);
      text-decoration: none;
    }

    .org-meta {
      margin-top: auto;
      padding-top: var(--space-2);
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      font-size: var(--fs-small);
      font-weight: 700;
      padding: 0.2em 0.7em;
      border-radius: 999px;
      letter-spacing: 0.02em;
    }

    .badge-domain {
      background: var(--color-surface);
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
      font-weight: 600;
      text-transform: none;
    }

    .badge-outline {
      background: transparent;
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
      font-weight: 600;
      text-transform: none;
    }

    .badge-tier-engaged {
      background: var(--color-badge-engaged-bg);
      color: var(--color-badge-engaged-text);
      text-transform: uppercase;
      font-size: 0.7rem;
    }

    .badge-tier-to-be-onboarded {
      background: var(--color-badge-onboard-bg);
      color: var(--color-badge-onboard-text);
      text-transform: uppercase;
      font-size: 0.7rem;
    }

    .badge-tier-not-member {
      background: var(--color-badge-notmember-bg);
      color: var(--color-badge-notmember-text);
      text-transform: uppercase;
      font-size: 0.7rem;
    }
  </style>
</BaseLayout>
