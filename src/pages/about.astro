---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, ABOUT_ILLUSTRATION } from "../lib/icons";

const whyList = [
  { icon: ICONS.link, text: "Act as an open, cross-domain forum connecting Irish researchers to a gateway to Europe." },
  { icon: ICONS.shieldCheck, text: "Reduce redundancy across Ireland's ESFRI-related investments." },
  { icon: ICONS.grid, text: "Ensure alignment on common technological and infrastructural needs across domains." },
  { icon: ICONS.megaphone, text: "Provide a unified, coordinated voice for Ireland's research domains in ESFRI-related matters." },
  { icon: ICONS.share, text: "Collaborate on shared projects and initiatives, including the European Open Science Cloud (EOSC), EOSC Ireland, and the HORIZON Europe INFRADEV funding programme." },
];

const stakeholders = [
  {
    icon: ICONS.users,
    title: "Researchers",
    text: "The end-users of ESFRI infrastructure — the reason IENN exists.",
  },
  {
    icon: ICONS.building,
    title: "Infrastructure Providers",
    text: "ESFRIs, EIROs, and national nodes delivering the infrastructure itself.",
  },
  {
    icon: ICONS.coins,
    title: "Funders",
    text: "Research Ireland and national investment such as INSPIRE.",
  },
  {
    icon: ICONS.landmark,
    title: "Government",
    text: "DFHERIS, and departments like Health given EHDS and data-space relevance.",
  },
];
---

<BaseLayout title="About" description="What IENN is, why it exists, and who it's working with.">
  <section class="section page-header-section">
    <div class="container hero-row">
      <div class="hero-text">
        <p class="eyebrow">About</p>
        <h1>About IENN</h1>
        <p class="section-intro" style="margin-left:0;">
          <strong>IENN</strong> — the <strong>Irish ESFRI Node Network</strong> — is a
          grassroots, cross-domain forum for Ireland's national nodes within the
          European Strategy Forum on Research Infrastructures (ESFRI).
          It has <strong>no formal or official connection to the European ESFRI forum</strong>.
          It began as an open initiative formed by three of Ireland's existing
          ESFRI nodes, <strong>DARIAH-Ireland</strong>, <strong>ELIXIR-Ireland</strong>,
          and <strong>ISSDA</strong>,
          to bring the country's ESFRI-facing communities into a single,
          coordinated conversation. While it is a grassroots effort, we hope to
          actively engage with the government departments responsible for and engaged
          with ESFRIs (such as DFHERIS) to support Ireland's research infrastructure.
        </p>
      </div>
      <div class="hero-illustration" aria-hidden="true" set:html={ABOUT_ILLUSTRATION} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Why IENN exists</h2>
      <ul class="why-list">
        {whyList.map((item) => (
          <li>
            <span class="why-icon" aria-hidden="true" set:html={item.icon} />
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <h2 class="section-heading-icon"><span class="heading-icon" set:html={ICONS.flask} />Our goal</h2>
      <p>
        Our goal is to support researchers across all domains with
        well-provisioned research infrastructure, backed by ESFRIs that meet
        Ireland's needs with European and global solutions that actually
        work in practice.
      </p>
      <p>
        Part of that means aligning over shared infrastructure, and ensuring
        systems are interoperable via metadata and data standards — and
        especially <strong>FAIR data</strong> and <strong>Open Science</strong> —
        which we consider core to a healthy research ecosystem.
      </p>
      <p>
        ESFRIs also play an important role in Ireland's wider research
        infrastructure landscape: representing research needs and domains
        as <strong>EOSC Ireland</strong> is built up, and providing valuable
        context for national investment such as <strong>INSPIRE</strong> —
        Ireland's national research infrastructure investment programme
        (Department of Further and Higher Education, Research, Innovation
        and Science / Research Ireland).
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Stakeholders</h2>
      <div class="grid grid-4">
        {stakeholders.map((s) => (
          <div class="card stakeholder-card">
            <span class="icon-badge" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p style="margin-bottom:0;">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .why-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      max-width: 780px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .why-list li {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      color: var(--color-text);
    }

    .why-icon {
      display: inline-flex;
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      margin-top: 2px;
      color: var(--color-accent);
    }

    .why-icon svg {
      width: 100%;
      height: 100%;
    }

    .stakeholder-card {
      display: flex;
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  </style>
</BaseLayout>
