---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const highlights = [
  {
    title: "Gateway to Europe",
    text: "Connecting Irish researchers and infrastructure to the wider European ESFRI landscape.",
  },
  {
    title: "Coordinated, not duplicated",
    text: "Reducing redundancy and aligning Ireland's ESFRI-related investments and technological needs.",
  },
  {
    title: "One voice, many domains",
    text: "A unified, coordinated voice for Ireland's research domains in ESFRI-related matters.",
  },
];

const exploreLinks = [
  { href: "about", title: "About", text: "What IENN is, why it exists, and who it's working with." },
  { href: "members", title: "Members", text: "The full ESFRI & EIRO registry and Ireland's engagement with each." },
  { href: "mailing-list", title: "Mailing List", text: "Subscribe to esfri-ireland@listserv.heanet.ie." },
  { href: "news-events", title: "News & Events", text: "Updates from across Ireland's ESFRI-facing community." },
  { href: "publications", title: "Publications", text: "Papers, reports, and outputs related to IENN's work." },
];
---

<BaseLayout title="Home">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">Irish ESFRI Node Network</p>
      <h1>Irish ESFRI Node Network (IENN)</h1>
      <p class="section-intro" style="margin-left:0;">
        IENN is a grassroots, cross-domain forum coordinating Ireland's
        engagement with European Strategy Forum on Research Infrastructures
        (ESFRI) Research Infrastructures — connecting researchers across
        every domain to Europe's shared research infrastructure landscape.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {highlights.map((h) => (
          <div class="card">
            <h3>{h.title}</h3>
            <p style="margin-bottom:0;">{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <div class="card callout">
        <p class="eyebrow">Where we are today</p>
        <h2>A grassroots coordination layer</h2>
        <p>
          IENN is <strong>not a formally ESFRI-endorsed body</strong>. It
          began as a bottom-up initiative led by DARIAH-Ireland and
          ELIXIR-Ireland, and operates today as an informal coordination
          layer for Ireland's ESFRI-facing community. As engagement and
          support grow across Ireland's research domains, we intend to
          pursue more formal recognition and structures.
        </p>
        <a class="btn btn-outline" href={`${base}about/`}>Read more about IENN</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Explore</h2>
      <div class="grid grid-3">
        {exploreLinks.map((link) => (
          <a class="card explore-card" href={`${base}${link.href}/`}>
            <h3>{link.title}</h3>
            <p style="margin-bottom:0;">{link.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .callout {
      border-left: 4px solid var(--color-accent);
    }

    .callout h2 {
      margin-bottom: var(--space-3);
    }

    .callout p {
      max-width: 700px;
    }

    .explore-card {
      display: block;
      color: var(--color-text);
    }

    .explore-card:hover {
      text-decoration: none;
    }

    .explore-card h3 {
      color: var(--color-link);
    }
  </style>
</BaseLayout>
