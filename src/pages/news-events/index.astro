---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsEventsSubNav from "../../components/NewsEventsSubNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import { ICONS } from "../../lib/icons";
---

<BaseLayout title="News" description="News from across Ireland's ESFRI community.">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">Latest</p>
      <h1>News &amp; Events</h1>
      <p class="section-intro" style="margin-left:0;">
        Updates from across Ireland's ESFRI community.
      </p>
    </div>
  </section>

  <NewsEventsSubNav active="news" />

  <section class="section">
    <div class="container">
      <EmptyState icon={ICONS.newspaper} />
    </div>
  </section>
</BaseLayout>
