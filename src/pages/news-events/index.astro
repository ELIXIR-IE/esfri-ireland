---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsEventsSubNav from "../../components/NewsEventsSubNav.astro";
---

<BaseLayout title="News" description="News from across Ireland's ESFRI-facing community.">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">Latest</p>
      <h1>News &amp; Events</h1>
      <p class="section-intro" style="margin-left:0;">
        Updates from across Ireland's ESFRI-facing community.
      </p>
    </div>
  </section>

  <NewsEventsSubNav active="news" />

  <section class="section">
    <div class="container">
      <p class="section-intro" style="margin-left:0;">
        Content for this page is coming soon.
      </p>
    </div>
  </section>
</BaseLayout>
