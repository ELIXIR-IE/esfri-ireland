---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsEventsSubNav from "../../components/NewsEventsSubNav.astro";
import EmptyState from "../../components/EmptyState.astro";
import { EVENT_ILLUSTRATION } from "../../lib/icons";
---

<BaseLayout title="Events" description="Events from across Ireland's ESFRI community.">
  <section class="section page-header-section">
    <div class="container hero-row">
      <div class="hero-text">
        <p class="eyebrow">Latest</p>
        <h1>News &amp; Events</h1>
        <p class="section-intro" style="margin-left:0;">
          Updates from across Ireland's ESFRI community.
        </p>
      </div>
      <div class="hero-illustration" aria-hidden="true" set:html={EVENT_ILLUSTRATION} />
    </div>
  </section>

  <NewsEventsSubNav active="events" />

  <section class="section">
    <div class="container">
      <EmptyState />
    </div>
  </section>
</BaseLayout>
