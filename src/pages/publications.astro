---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import { DOCUMENT_ILLUSTRATION } from "../lib/icons";
---

<BaseLayout title="Publications">
  <section class="section page-header-section">
    <div class="container hero-row">
      <div class="hero-text">
        <p class="eyebrow">Publications</p>
        <h1>Publications</h1>
        <p class="section-intro" style="margin-left:0;">
          Papers, reports, and outputs related to IENN's work.
        </p>
      </div>
      <div class="hero-illustration" aria-hidden="true" set:html={DOCUMENT_ILLUSTRATION} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EmptyState />
    </div>
  </section>
</BaseLayout>
