---
import yaml from "js-yaml";
import rawYaml from "../data/people.yaml?raw";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PEOPLE_ILLUSTRATION } from "../lib/icons";

interface Person {
  name: string;
  email: string;
  esfri: string;
  domain: string;
  institute: string;
  role: string;
}

const people = yaml.load(rawYaml) as Person[];

const groupOrder = [...new Set(people.map((p) => p.esfri))].sort((a, b) => a.localeCompare(b));
const groups = groupOrder.map((esfri) => ({
  esfri,
  domain: people.find((p) => p.esfri === esfri)!.domain,
  people: people
    .filter((p) => p.esfri === esfri)
    .sort((a, b) => a.name.localeCompare(b.name)),
}));

const issueUrl =
  "https://github.com/ELIXIR-IE/esfri-ireland/issues/new?template=person_listing.yml";
---

<BaseLayout title="People" description="IENN's active members, grouped by node.">
  <section class="section page-header-section">
    <div class="container hero-row">
      <div class="hero-text">
        <p class="eyebrow">People</p>
        <h1>People</h1>
        <p class="section-intro" style="margin-left:0;">
          IENN's active members, grouped by node.
        </p>
      </div>
      <div class="hero-illustration" aria-hidden="true" set:html={PEOPLE_ILLUSTRATION} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="registry-filters card">
        <div class="filter-field">
          <label for="esfri-filter">Filter by ESFRI / node</label>
          <select id="esfri-filter">
            <option value="">All nodes</option>
            {groupOrder.map((esfri) => <option value={esfri}>{esfri}</option>)}
          </select>
        </div>
      </div>

      {groups.map((group) => (
        <div class="people-group" data-people-group={group.esfri}>
          <h2 class="people-group-heading">
            {group.esfri}
            <span class="people-group-domain">{group.domain}</span>
          </h2>
          <div class="grid people-grid">
            {group.people.map((person) => (
              <div class="card person-card" data-esfri={person.esfri}>
                <div class="person-avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8v1H4v-1Z"></path>
                  </svg>
                </div>
                <h3 class="person-name">{person.name}</h3>
                <p class="person-role">{person.role}</p>
                <div class="person-affiliations">
                  <span class="badge badge-esfri">{person.esfri}</span>
                  <span class="badge badge-institute">{person.institute}</span>
                </div>
                <a
                  class="person-mail"
                  href={`mailto:${person.email}`}
                  title={person.email}
                  aria-label={`Email ${person.name} (${person.email})`}
                >
                  <svg class="mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="card callout people-callout">
        <h2>Not listed here, or need an update?</h2>
        <p>
          If you're part of an IENN founding node and aren't listed, or your
          details need updating, let us know via GitHub.
        </p>
        <a class="btn btn-primary" href={issueUrl} target="_blank" rel="noopener">
          Add or update a person
        </a>
      </div>
    </div>
  </section>

  <script>
    const esfriFilter = document.querySelector<HTMLSelectElement>("#esfri-filter");
    const cards = Array.from(document.querySelectorAll<HTMLDivElement>(".person-card"));
    const groupSections = Array.from(document.querySelectorAll<HTMLDivElement>("[data-people-group]"));

    function applyFilter() {
      const esfri = esfriFilter?.value ?? "";

      cards.forEach((card) => {
        const show = !esfri || card.dataset.esfri === esfri;
        card.style.display = show ? "" : "none";
      });

      groupSections.forEach((section) => {
        const anyVisible = Array.from(section.querySelectorAll<HTMLDivElement>(".person-card")).some(
          (c) => c.style.display !== "none"
        );
        section.style.display = anyVisible ? "" : "none";
      });
    }

    esfriFilter?.addEventListener("change", applyFilter);
    applyFilter();
  </script>

  <style>
    .registry-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: flex-end;
      margin-bottom: var(--space-6);
      background: var(--color-bg-subtle);
    }

    .filter-field {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      flex: 1 1 220px;
    }

    .filter-field label {
      font-size: var(--fs-small);
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .filter-field select {
      padding: 0.6rem 0.8rem;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 1rem;
    }

    .filter-field select:focus {
      border-color: var(--color-accent);
      outline: none;
    }

    .people-group {
      margin-bottom: var(--space-7);
    }

    .people-group-heading {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .people-group-domain {
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--color-text-muted);
    }

    .people-grid {
      margin-top: var(--space-4);
      grid-template-columns: repeat(auto-fill, 240px);
      justify-content: start;
    }

    .person-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      width: 240px;
    }

    .person-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--color-bg-subtle);
      color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .person-name {
      margin-bottom: 0;
      font-size: 1.1rem;
    }

    .person-role {
      color: var(--color-text-muted);
      font-size: var(--fs-small);
      margin-bottom: 0;
    }

    .person-affiliations {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
      margin: var(--space-2) 0;
    }

    .badge-esfri {
      background: var(--color-green-800);
      color: #fff;
      text-transform: uppercase;
      font-size: 0.7rem;
    }

    .badge-institute {
      background: transparent;
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
      font-weight: 600;
      text-transform: none;
    }

    .person-mail {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: var(--color-text-muted);
      margin-top: var(--space-2);
      border: 1px solid var(--color-border);
    }

    .person-mail:hover {
      color: var(--color-accent-contrast);
      background: var(--color-accent);
      border-color: var(--color-accent);
    }

    .mail-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    .people-callout {
      border-left: 4px solid var(--color-accent);
      background: var(--color-bg-subtle);
    }

    .people-callout h2 {
      margin-bottom: var(--space-2);
    }
  </style>
</BaseLayout>
