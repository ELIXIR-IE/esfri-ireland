---
import yaml from "js-yaml";
import rawYaml from "../data/people.yaml?raw";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Person {
  name: string;
  email: string;
  esfri: string;
  domain: string;
  institute: string;
  role: string;
}

const people = yaml.load(rawYaml) as Person[];

const groupOrder = [...new Set(people.map((p) => p.esfri))];
const groups = groupOrder.map((esfri) => ({
  esfri,
  domain: people.find((p) => p.esfri === esfri)!.domain,
  people: people.filter((p) => p.esfri === esfri),
}));

const issueUrl =
  "https://github.com/ELIXIR-IE/esfri-ireland/issues/new?template=person_listing.yml";
---

<BaseLayout title="People" description="The people behind IENN's founding ESFRI nodes.">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">People</p>
      <h1>People</h1>
      <p class="section-intro" style="margin-left:0;">
        The people behind IENN's founding ESFRI nodes, grouped by node.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {groups.map((group) => (
        <div class="people-group">
          <h2 class="people-group-heading">
            {group.esfri}
            <span class="people-group-domain">{group.domain}</span>
          </h2>
          <div class="grid grid-3 people-grid">
            {group.people.map((person) => (
              <div class="card person-card">
                <div class="person-avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8v1H4v-1Z"></path>
                  </svg>
                </div>
                <h3 class="person-name">{person.name}</h3>
                <p class="person-role">{person.role}</p>
                <div class="person-affiliations">
                  <span class="badge badge-esfri">{person.esfri}</span>
                  <span class="badge badge-institute">{person.institute}</span>
                </div>
                <a class="person-mail" href={`mailto:${person.email}`} aria-label={`Email ${person.name}`}>
                  <svg class="mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                  {person.email}
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="card callout people-callout">
        <h2>Not listed here, or need an update?</h2>
        <p>
          If you're part of an IENN founding node and aren't listed, or your
          details need updating, let us know via GitHub.
        </p>
        <a class="btn btn-primary" href={issueUrl} target="_blank" rel="noopener">
          Add or update a person
        </a>
      </div>
    </div>
  </section>

  <style>
    .people-group {
      margin-bottom: var(--space-7);
    }

    .people-group-heading {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .people-group-domain {
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--color-text-muted);
    }

    .people-grid {
      margin-top: var(--space-4);
    }

    .person-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
    }

    .person-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--color-bg-subtle);
      color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .person-name {
      margin-bottom: 0;
      font-size: 1.1rem;
    }

    .person-role {
      color: var(--color-text-muted);
      font-size: var(--fs-small);
      margin-bottom: 0;
    }

    .person-affiliations {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
      margin: var(--space-2) 0;
    }

    .badge-esfri {
      background: var(--color-green-800);
      color: #fff;
      text-transform: uppercase;
      font-size: 0.7rem;
    }

    .badge-institute {
      background: transparent;
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
      font-weight: 600;
      text-transform: none;
    }

    .person-mail {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      font-size: var(--fs-small);
      font-weight: 600;
      margin-top: var(--space-2);
      word-break: break-all;
    }

    .mail-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    .people-callout {
      border-left: 4px solid var(--color-accent);
      background: var(--color-bg-subtle);
    }

    .people-callout h2 {
      margin-bottom: var(--space-2);
    }
  </style>
</BaseLayout>
